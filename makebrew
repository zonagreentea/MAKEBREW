#!/bin/zsh -f

emulate -L zsh

BREW="$(command -v brew)"

[[ -x "$BREW" ]] || {
  print -u2 "MAKEBREW: Homebrew is required."
  print -u2 "Install it from https://brew.sh"
  exit 127
}

(( $# )) || {
  print 'MAKEBREW — universal software installer'
  print 'Usage: makebrew <software|command>'
  exit 0
}

case "$1" in
  osu|osu!|osu!lazer)
    shift
    exec "$BREW" install --cask osu "$@"
    ;;
  update|upgrade|list|search|info|doctor|cleanup|\
  uninstall|remove|reinstall|outdated|tap|untap|\
  services|config|--version|--help|help)
    exec "$BREW" "$@"
    ;;
  *)
    exec "$BREW" install "$@"
    ;;
esac
