#!/bin/zsh
emulate -L zsh
setopt errexit nounset pipefail

usage() {
  print 'MAKEBREW'
  print 'Usage: makebrew {help|doctor|open|run|make} [arguments]'
}

(( $# )) || { usage; exit 0; }

command_name="$1"
shift

case "$command_name" in
  help)
    usage
    ;;
  doctor)
    print 'MAKEBREW diagnostics'
    for tool in zsh make; do
      if command -v "$tool" >/dev/null 2>&1; then
        print "PASS: $tool"
      else
        print "MISSING: $tool"
      fi
    done
    ;;
  open)
    (( $# == 1 )) || { print -u2 'Expected one file'; exit 2; }
    [[ -e "$1" ]] || { print -u2 'File not found'; exit 1; }
    command open -- "$1"
    ;;
  run)
    (( $# )) || { print -u2 'Missing program'; exit 2; }
    exec "$@"
    ;;
  make)
    exec make "$@"
    ;;
  *)
    print -u2 "Unknown command: $command_name"
    exit 2
    ;;
esac
