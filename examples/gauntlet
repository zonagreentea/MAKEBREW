#!/bin/zsh
# Gauntlet OS: single-process, character-cell workspace for macOS.
emulate -R zsh
setopt no_beep extended_glob

ROOT="${0:A:h}"
typeset -g CURRENT="$HOME" MESSAGE='Ready.' PAGE='home' RUNNING=1
integer HEIGHT=24 WIDTH=80 SELECTED=1 OFFSET=0
integer COUNT=0
integer IN_SCREEN=0
integer MAX_ITEMS=8
typeset -a ENTRIES

terminal_size() {
  local dimensions
  dimensions="$(stty size </dev/tty 2>/dev/null)" || dimensions='24 80'
  HEIGHT="${dimensions%% *}"
  WIDTH="${dimensions##* }"
  (( HEIGHT > 0 )) || HEIGHT=24
  (( WIDTH > 0 )) || WIDTH=80
  MAX_ITEMS=$(( HEIGHT - 10 ))
  (( MAX_ITEMS > 0 )) || MAX_ITEMS=1
}

at() { printf '\033[%d;%dH' "$1" "$2"; }
clear_screen() { printf '\033[H\033[2J'; }
line() {
  local row="$1" value="$2" available=$(( WIDTH - 4 ))
  (( row > 0 && row <= HEIGHT )) || return 0
  (( available > 0 )) || return 0
  at "$row" 3
  printf '%-*.*s' "$available" "$available" "$value"
}

enter_screen() {
  (( IN_SCREEN )) && return
  printf '\033[?1049h\033[?25l'
  IN_SCREEN=1
}
leave_screen() {
  (( IN_SCREEN )) || return
  printf '\033[?25h\033[?1049l'
  IN_SCREEN=0
}
cleanup() {
  trap - EXIT INT TERM HUP
  leave_screen
}
trap cleanup EXIT
trap 'RUNNING=0' INT TERM HUP

ask() {
  local prompt="$1" reply
  at "$HEIGHT" 1
  printf '\033[2K\033[?25h%s' "$prompt"
  IFS= read -r reply || { RUNNING=0; return 1; }
  printf '\033[?25l'
  ANSWER="$reply"
}

external() {
  local result
  leave_screen
  print -r -- ''
  "$@"
  result=$?
  print -r -- ''
  printf 'Exit status: %s. Press Enter to return to Gauntlet OS...' "$result"
  IFS= read -r _ || RUNNING=0
  MESSAGE="Exit status: $result"
  (( RUNNING )) && enter_screen
}

refresh_entries() {
  local -a found
  found=("$CURRENT"/*(DN))
  ENTRIES=("${found[@]}")
  COUNT=${#ENTRIES}
  (( OFFSET < COUNT )) || OFFSET=0
  (( SELECTED >= 1 )) || SELECTED=1
  (( SELECTED <= COUNT )) || SELECTED=COUNT
  (( SELECTED >= 1 )) || SELECTED=1
}

render() {
  terminal_size
  clear_screen
  line 1 'GAUNTLET OS  /  MAKEBREW'
  line 2 '=================================================================='
  line 3 "LOCATION  $CURRENT"
  if (( WIDTH < 38 || HEIGHT < 13 )); then
    line 5 'Resize terminal (min 38 x 13)'
    line "$HEIGHT" 'Q: quit'
    return
  fi
  if [[ "$PAGE" == home ]]; then
    line 5 '1  Explore files         2  Run program'
    line 6 '3  Zsh shell             4  Build project'
    line 7 '5  Install package       6  Installed packages'
    line 8 '7  System status         8  MAKEBREW'
    line 9 '0  Exit'
    line 11 'Choose a number. Press Q to quit.'
  else
    line 5 'FILES   J/K: move   ENTER: open   H: parent   R: refresh   B: back'
    local row=6 index entry marker label
    for (( index=OFFSET+1; index<=COUNT && row<HEIGHT-4; index++ )); do
      entry="${ENTRIES[index]}"
      label="${entry:t}"
      [[ -d "$entry" ]] && label="[DIR] $label" || label="      $label"
      marker=' '
      (( index == SELECTED )) && marker='>'
      line "$row" "$marker $label"
      (( row++ ))
    done
    (( COUNT == 0 )) && line 7 '(empty directory)'
  fi
  line "$((HEIGHT-3))" '------------------------------------------------------------------'
  line "$((HEIGHT-2))" "EVENT  $MESSAGE"
  line "$HEIGHT" 'gauntlet > '
}

browse_move() {
  local delta="$1"
  (( COUNT > 0 )) || return
  SELECTED=$(( SELECTED + delta ))
  (( SELECTED < 1 )) && SELECTED=1
  (( SELECTED > COUNT )) && SELECTED=COUNT
  (( SELECTED <= OFFSET )) && OFFSET=$(( SELECTED - 1 ))
  (( SELECTED > OFFSET + MAX_ITEMS )) && OFFSET=$(( SELECTED - MAX_ITEMS ))
}

browse_open() {
  (( COUNT > 0 )) || return
  local entry="${ENTRIES[SELECTED]}"
  if [[ -d "$entry" ]]; then
    CURRENT="${entry:A}"
    SELECTED=1 OFFSET=0
    refresh_entries
  elif [[ -x "$entry" ]]; then
    external "$entry"
  elif [[ "$(uname -s)" == Darwin ]]; then
    external /usr/bin/open "$entry"
  else
    MESSAGE='Select an executable or directory.'
  fi
}

run_program() {
  local -a words
  ask 'Program (Zsh command line): ' || return
  [[ -z "$ANSWER" ]] && return
  # Zsh lexing without eval; shell operators are not interpreted.
  words=("${(z)ANSWER}")
  (( ${#words} )) || return
  local command_name="${words[1]}"
  if [[ "$command_name" == */* ]]; then
    [[ -x "$command_name" ]] || { MESSAGE='Executable not found.'; return; }
  elif ! (( $+commands[$command_name] )); then
    MESSAGE='Command not found.'
    return
  fi
  external "${words[@]}"
}

install_package() {
  (( $+commands[brew] )) || { MESSAGE='Homebrew unavailable.'; return; }
  ask 'Homebrew formula: ' || return
  local package="$ANSWER"
  [[ -z "$package" ]] && return
  ask "Install $package? Type yes: " || return
  [[ "$ANSWER" == yes ]] && external brew install --formula "$package" || MESSAGE='Cancelled.'
}

home_action() {
  case "$1" in
    1) PAGE=files; SELECTED=1 OFFSET=0; refresh_entries ;;
    2) run_program ;;
    3) external /bin/zsh -l ;;
    4) if (( $+commands[make] )); then external make -C "$CURRENT"; else MESSAGE='Make unavailable.'; fi ;;
    5) install_package ;;
    6) if (( $+commands[brew] )); then external brew list; else MESSAGE='Homebrew unavailable.'; fi ;;
    7) external /usr/bin/uname -a ;;
    8) if [[ -x "$ROOT/makebrew" ]]; then external "$ROOT/makebrew"; else MESSAGE='MAKEBREW unavailable.'; fi ;;
    0|q|Q) RUNNING=0 ;;
    *) MESSAGE='Unknown command.' ;;
  esac
}

main() {
  [[ -t 0 && -t 1 ]] || { print -u2 'Gauntlet OS requires an interactive terminal.'; return 1; }
  enter_screen
  local key
  while (( RUNNING )); do
    render
    at "$HEIGHT" 14
    printf '\033[?25h'
    IFS= read -r -k 1 key || break
    printf '\033[?25l'
    if [[ "$PAGE" == home ]]; then
      home_action "$key"
    else
      case "$key" in
        j|J) browse_move 1 ;;
        k|K) browse_move -1 ;;
        h|H) CURRENT="${CURRENT:h}"; SELECTED=1 OFFSET=0; refresh_entries ;;
        r|R) refresh_entries ;;
        b|B|q|Q|0) PAGE=home ;;
        $'\r'|$'\n') browse_open ;;
        *) MESSAGE='Use J/K, Enter, H, R or B.' ;;
      esac
    fi
  done
}
main "$@"
